// Cloudflare deploy settings. `npx wrangler deploy` uploads the built game (client/dist)
// as static files. Build first with `npm run build`.
// If your Worker in the Cloudflare dashboard has a different name, change "name" to match it.
{
  "name": "blockfire",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application"
  }
}
